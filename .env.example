# PFM — copy to .env.local; never commit real values.
# MyDB via the least-privilege `pfm` role: RW financialmanager, RO source schemas (DB-enforced).
DATABASE_URL=postgresql://pfm:PASSWORD@data02:5432/MyDB
PFM_PIN=
# Session cookie secret for the PIN gate (set to a long random string in prod).
PFM_SESSION_SECRET=
# AI (optional, manual-first). OFF unless AI_ENABLED=true AND MOE_BASE_URL set.
AI_ENABLED=false
MOE_BASE_URL=http://192.168.42.226:11434/v1
# MOE_MODEL=qwen2.5
# MOE_API_KEY=
# Schwab OAuth token services (callback + refresher). PFM owns the Schwab token.
# On the cluster these live in /mnt/qnap/config/pfm.env, not here.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://callback.bolivardrive.com/callback
# Transitional: mirror to the shared tokens.json the prop-desk consumers read.
SCHWAB_TOKENS_FILE=/mnt/qnap/schwab_token/tokens.json
# SCHWAB_REFRESH_SECONDS=1200
